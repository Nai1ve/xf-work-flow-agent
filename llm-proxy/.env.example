# 复制为 .env 后填写（.env 已被 gitignore，不入库）。

# —— 代理自身鉴权（必填，强随机值，切勿用真实上游 key）——
# 生成：python3 -c "import secrets;print(secrets.token_hex(32))"
PROXY_API_KEY=changeme-strong-random-32-bytes-hex

# —— 真实上游供应商（服务端持有真实 key；仅此 env，绝不落文件/日志/仓库）——
UPSTREAM_BASE_URL=https://your-provider.example/v1
UPSTREAM_API_KEY=changeme-real-upstream-key

# —— 监听（默认 127.0.0.1：只接受本机；远程评估再改并自行加 TLS/鉴权）——
HOST=127.0.0.1
PORT=8787

# —— 日志（gitignored）——
LOG_DIR=logs

# —— 转发超时 / body 上限（字节）——
UPSTREAM_TIMEOUT_S=60
MAX_BODY_BYTES=524288
